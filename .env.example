# Service-account credentials are never committed. Use Application Default Credentials in production.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
# For local integration tests only, point Admin SDK at the Firebase emulator.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
ADMIN_PASSWORD=replace-this-before-first-start
